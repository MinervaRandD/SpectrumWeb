@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    @using SpectrumWeb.Models;
    @model GuaranteeWarranty;
    PartsMaster pm = @ViewBag.Data;


    string themeForegroundColor = Utilities.SystemSettings.ThemeForegroundColor;
    string backgroundColor = Utilities.SystemSettings.ThemeBackgroundColor;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <style>
        .labelTd {
            width: 180px;
        }

        tr {
            height: 48px;
        }

        label {
            color: @themeForegroundColor;
            font: large;
            font-weight: bold;
        }

        input {
            color: @themeForegroundColor;
            border: solid;
            border-color: @themeForegroundColor;
            border-width: 2px;
        }

        td {
            color: @themeForegroundColor;
            font: large;
        }

        .tableContainer {
            display: flex;
            align-items: center;
            font-size: 16px;
            color: @themeForegroundColor;
        }
    </style>
</head>

<body>
    <h2 style="color:@themeForegroundColor;margin-top:16px;margin-bottom:16px;margin-left:auto;margin-right:auto;margin-top:32px;width:100%;" align="center">
        Parts Master Details
    </h2>

    <div style="height:16px"> </div>

    <form method="post" id="partMasterForm">

        <div style="width:100%;margin:auto;display:block;text-align:center;">
            <label for="taskId" style="width:256px;">Part Number: </label><input type="text" id="partNmbr" name="partNmbr" style="width:128px;" value="@pm.PartNumber" />
        </div>

        <div style="height:16px"></div>

        <div style="width:100%;display:block;align-content:center;text-align:center;">

            <div style="margin:32px;display:inline-block;">

                <table style="color:@themeForegroundColor;font-size:16px;">
                    <tr>
                        <td><label for="rwitmx">Rwitmx:</label></td>
                        <td><input type="text" id="rwitmx" name="rwitmx" value="@pm.Rwitmx" /></td>
                    </tr>
                    <tr>
                        <td><label for="warehouse">Warehouse: </label></td>
                        <td><input type="text" id="warehouse" name="warehouse" value="@pm.Warehouse" /></td>
                    </tr>
                    <tr>
                        <td><label for="partsDesignator">Rwitmx:</label></td>
                        <td><input type="text" id="partsDesignator" name="partsDesignator" value="@pm.PartDesignator" /></td>
                    </tr>
                    <tr>
                        <td><label for="qtyOutForRepr">Warehouse: </label></td>
                        <td><input type="number" id="qtyOutForRepr" name="qtyOutForRepr" value="@pm.QtyOutForRepr" /></td>
                    </tr>

                    <tr>
                        <td><label for="allotment">Allotment</label></td>
                        <td><input type="number" id="allotment" name="allotment" value="@pm.Allotment" /></td>
                    </tr>
                    <tr>
                        <td><label for="inSuspense">In Suspense: </label></td>
                        <td><input type="number" id="inSuspense" name="inSuspense" value="@pm.InSuspense" /></td>
                    </tr>
                    <tr>
                        <td><label for="orderQuantity">Order Qty:</label></td>
                        <td><input type="number" id="orderQuantity" name="orderQuantity" value="@pm.OrderQuantity" /></td>
                    </tr>
                    <tr>
                        <td><label for="renmbrLinksFiles">Ref Nmbr Links Files: </label></td>
                        <td><input type="number" id="renmbrLinksFiles" name="renmbrLinksFiles" value="@pm.RefnmbrLinksFiles" /></td>
                    </tr>
                    <tr>
                        <td><label for="nmbrOfSpares">Nmbr Spares: </label></td>
                        <td><input type="number" id="nmbrOfSpares" name="nmbrOfSpares" value="@pm.NumberOfSpares" /></td>
                    </tr>
                </table>
            </div>
            <div style="display:inline-block;margin:32px;vertical-align:top">
                <table style="color:@themeForegroundColor;font-size:16px;">
                    <tr>
                        <td><label for="vendor1">Vendor 1: </label></td>
                        <td><input type="text" id="vendor1" name="vendor1" value="@pm.Vendor1" /></td>
                    </tr>
                    <tr>
                        <td><label for="vendor2">Vendor 2: </label></td>
                        <td><input type="text" id="vendor2" name="vendor2" value="@pm.Vendor2" /></td>
                    </tr>
                    <tr>
                        <td><label for="vendor3">Vendor 3: </label></td>
                        <td><input type="text" id="vendor3" name="vendor3" value="@pm.Vendor3" /></td>
                    </tr>
                    <tr>
                        <td><label for="currPoNmbr">Curr PO Nmbr: </label></td>
                        <td><input type="text" id="currPoNmbr" name="currPoNmbr" value="@pm.CurrentPoNmbr" /></td>
                    </tr>

                    <tr>
                        <td><label for="currPoType">Curr PO Type: </label></td>
                        <td><input type="text" id="currPoType" name="currPoType" value="@pm.CurrentPoType" /></td>
                    </tr>
                    <tr>
                        <td><label for="lastPoNmbr">Last PO Nmbr: </label></td>
                        <td><input type="text" id="lastPoNmbr" name="lastPoNmbr" value="@pm.LastPoNmbr" /></td>
                    </tr>
                    <tr>
                        <td><label for="lastPoType">Last PO Type: </label></td>
                        <td><input type="text" id="lastPoType" name="lastPoType" value="@pm.LastPoType" /></td>
                    </tr>

                    <tr>
                        <td><label for="avgVendLeadTm">Avg Vend Lead Tm: </label></td>
                        <td><input type="number" id="avgVendLeadTm" name="avgVendLeadTm" value="@pm.AvgVendLeadTm" /></td>
                    </tr>
                    <tr>
                        <td><label for="avgRepairTm">Avg Repair Tm: </label></td>
                        <td><input type="number" id="avgRepairTm" name="avgRepairTm" value="@pm.AvgReprLeadTm" /></td>
                    </tr>
                   

                </table>
            </div>

            <div style="display:inline-block;margin:32px;vertical-align:top">
                <table style="color:@themeForegroundColor;font-size:16px;">
                    <tr>
                        <td><label for="currPrice">Curr Price: </label></td>
                        <td><input type="number" id="currPrice" name="currPrice" value="@pm.CurrentPrice" /></td>
                    </tr>
                    <tr>
                        <td><label for="lastPrice">Last Price: </label></td>
                        <td><input type="number" id="lastPrice" name="lastPrice" value="@pm.LastPrice" /></td>
                    </tr>
                    <tr>
                        <td><label for="avePrice">Ave Price: </label></td>
                        <td><input type="number" id="avePrice" name="avePrice" value="@pm.AveragePrice" /></td>
                    </tr>
                    <tr>
                        <td><label for="prcBrkAvail">Ave Price: </label></td>
                        <td><input type="number" id="prcBrkAvail" name="prcBrkAvail" value="@pm.PrcBreakAvail" /></td>
                    </tr>
                </table>
            </div>

        </div>
    </form>
</body>
</html>