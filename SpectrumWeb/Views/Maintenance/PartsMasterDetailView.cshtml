@{
    @using SpectrumWeb.Models;
    @model GuaranteeWarranty;
    PartsMaster pm = @ViewBag.Data;


    string themeForegroundColor = Utilities.SystemSettings.ThemeForegroundColor;
    string backgroundColor = Utilities.SystemSettings.ThemeBackgroundColor;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />


    <style>
        .labelTd {
            width: 180px;
        }

        tr {
            height: 48px;
        }

        label {
            color: @themeForegroundColor;
            font: large;
            font-weight: bold;
        }

        input {
            color: @themeForegroundColor;
            border: solid;
            border-color: @themeForegroundColor;
            border-width: 2px;
        }

        td {
            color: @themeForegroundColor;
            font: large;
        }

        .tableContainer {
            display: flex;
            align-items: center;
            font-size: 16px;
            color: @themeForegroundColor;
        }
    </style>
</head>

<body>
    <h2 style="color:@themeForegroundColor;margin-top:16px;margin-bottom:16px;margin-left:auto;margin-right:auto;margin-top:32px;width:100%;" align="center">
        Parts Master Details
    </h2>

    <div style="height:16px"> </div>

    <form method="post" id="partMasterForm">

        <div style="width:100%;margin:auto;display:block;text-align:center;">
            <label for="taskId" style="width:256px;">Part Number: </label><input type="text" id="partNmbr" name="partNmbr" style="width:128px;" value="@pm.PartNumber" />
        </div>

        <div style="height:16px"></div>

        <div style="width:100%;display:block;align-content:center;text-align:center;">

            <div style="margin:32px;display:inline-block;">

                <table style="color:@themeForegroundColor;font-size:16px;">
                    <tr>
                        <td><label for="rwitmx">Rwitmx</label></td>
                        <td><input type="text" id="rwitmx" name="rwitmx" value="@pm.Rwitmx" /></td>
                    </tr>
                    <tr>
                        <td><label for="warehouse">Warehouse: </label></td>
                        <td><input type="text" id="warehouse" name="warehouse" value="@pm.Warehouse" /></td>
                    </tr>
                </table>
            </div>
            <div style="display:inline-block;margin:32px;vertical-align:top">
                <table style="color:@themeForegroundColor;font-size:16px;">

                    @*  <tr>
                    <td> <label for="cyclesAtInstall">Cycles At Install: </label></td>
                    <td> <input type="number" id="cyclesAtInstall" name="cyclesAtInstall" value="@gw.CyclsAtInstall" /></td>
                    </tr>
                    <tr>
                    <td> <label for="weeksAtInstall">Weeks At Install: </label></td>
                    <td> <input type="number" id="weeksAtInstall" name="weeksAtInstall" value="@gw.WeeksAtInstall" /></td>
                    </tr>

                    <tr>
                    <td> <label for="exchangedSerNmbr">Exchange Serial Nmbr: </label></td>
                    <td> <input type="text" id="exchangedSerNmbr" name="exchangedSerNmbr" value="@gw.ExchangedSerNmbr" /></td>
                    </tr>
                    <tr>
                    <td> <label for="controlTag">Control Tag: </label></td>
                    <td> <input type="text" id="controlTag" name="controlTag" value="@gw.ControlTag" /></td>
                    </tr>
                    <tr>
                    <td><label for="vendorNmbr">Vendor Nmbr: </label></td>
                    <td><input type="text" id="vendorNmbr" name="vendorNmbr" value="@gw.VendorNumber" /></td>
                    </tr>
                    <tr>
                    <td><label for="ataChap">ATA Chapter: </label></td>
                    <td><input type="text" id="ataChap" name="ataChap" value="@gw.AtaChap" /></td>
                    </tr> *@

                </table>
            </div>

        </div>

    </form>
</body>
</html>