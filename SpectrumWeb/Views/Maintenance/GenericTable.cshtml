@{
    ViewData["Title"] = "Home Page";

    string initSearchTitle = ViewBag.InitSearchTitle ;

    string initSearchValue = ViewBag.InitSearchValue ;

    string themeForegroundColor = Utilities.SystemSettings.ThemeForegroundColor;
    string themeBackgroundColor = Utilities.SystemSettings.ThemeBackgroundColor;

    if (string.IsNullOrEmpty(initSearchTitle))
    {
        initSearchTitle = "";
    }

    if (string.IsNullOrEmpty(initSearchValue))
    {
        initSearchValue = "''";
    }

    string tableSetup = "";

    if (!string.IsNullOrEmpty(ViewBag.TableSetup))
    {
        tableSetup = ViewBag.TableSetup.Replace("@themeForegroundColor", themeForegroundColor).Replace("@themeBackgroundColor", themeBackgroundColor);
    }
}

<style>
    tfoot input {
        width: 100%;
    }

    tfoot th, tfoot td {
        text-align: left !important;
    }
</style>
<script>
    var table;

    function setupBaseDataTable() {
        table = new DataTable('#classTable',
            {

                layout:
                {
                    top2: 'searchPanes',
                    top1: {
                        buttons: [
                            'print', 'searchBuilder'
                        ]
                    },
                },

                searchPanes: {
                    viewTotal: true,
                    layout: 'columns-4',
                    columns: [3, 4, 16, 17],
                    threshold: 1,
                    header: 'Hello sailor',
                },

                fixedHeader: {
                    header: true,
                    footer: true
                },

                "pageLength": 16,

                columns: [
                    @Html.Raw(@ViewBag.TableColumns)
                ],

                @Html.Raw(ViewBag.ColumnDefs)

                select: true,

                buttons: [
                    { extend: 'print' },
                    { extend: 'searchBuilder' },
                 ],

                initComplete: function () {
                    let initSearchTitle = '@initSearchTitle';

                    let initSearchValue = '@initSearchValue';

                    
                    console.log('initSearchTitle=' + initSearchTitle);
                    console.log('initSearchValue=' + initSearchValue);

                    this.api()
                        .columns()
                        .every(function () {
                           
                            let column = this;


                            let title = column.footer().textContent;

                            console.log('title=' + title);

                            if (title != "Edit" && title.length > 0) {

                                // Create input element
                                let input = document.createElement('input');


                                if (title == initSearchTitle) {
                                    console.log("Match Found.");
                                    input.placeholder = initSearchValue;
                                    input.value = initSearchValue;
                                    column.search(initSearchValue).draw();
                                }

                                else {
                                    input.placeholder = title;
                                }                               
                                
                                
                                column.footer().replaceChildren(input);

                                // Event listener for user input
                                input.addEventListener('keyup', () => {
                                    if (column.search() !== this.value) {
                                        column.search(input.value).draw();
                                    }
                                })
                            };
                        });
                },

                scrollX: true,
                scrollY: true,
                fixedColumns: false,
          });

    }
    function activateDetailsView(detailsUrl, id) {
        window.open(detailsUrl + '?id=' + id);
    }

    function setupClickResponses() {

    }

    function format(d) {

        rtrnValu = @Html.Raw(ViewBag.ChildFieldFormatter);

        //console.log(rtrnValu);

        return (rtrnValu);

    }
    
   
    $(document).ready(function () {

        setupBaseDataTable();

        setupClickResponses();

        document.getElementById('header').remove();
        document.getElementById('footer').remove();
    }
    )

    function removeTableSetup() { 
        document.getElementById('tableSetup').style.display = "none";
    }
       

</script>

<body style="background-color:white">

<div class="row">
    <div class="col-1" style="width:32px"></div>

    <div class="col-11" >
         <div id="tableDiv" style="z-index:1;position:absolute;position:fixed;top:0">
            <table id="classTable" class="table table-striped table-bordered table-hover" style="table-layout:fixed;float:left;@ViewBag.TableWidth">
                <thead>
                    <tr style="color:@themeForegroundColor">
                        @Html.Raw(@ViewBag.TableHeader)
                    </tr>
                </thead>
               
                <tbody id='classTableBody'>
                    @Html.Raw(@ViewBag.ClassTableBody)
                </tbody>
                <tfoot>
                    <tr>
                        @Html.Raw(@ViewBag.TableFooter)
                    </tr>
                </tfoot>

            </table>
        </div>

        @Html.Raw(@tableSetup)
       
    </div>
</div>

</body>
