<div popover id="signinForm"  style="position:absolute;border-radius:16px;border-color:darkblue;width:512px;margin-top:120px">
    <h2 style="color:darkblue">Sign In</h2>
    <hr>
    <form>
        <p>
            <label>Username:</label>
            <input type="text" onclick="clearSigninErrorMessage()" name="userId" id="userId">
        </p>
        <p>
            <label>Password:</label>
            <input type="password" onclick="clearSigninErrorMessage()" name="password" id="password" />
            <i class="bi bi-eye-slash" id="togglePassword"></i>
        </p>

    </form>
    <div style="height:12px"></div>
    <button onclick="validateSignIn()" style="color:darkblue;border-color:darkblue;border-width:2px;border-radius:4pt;width:256px;height:40px;margin-left:80px;font-size:larger;font-weight:bold">
        Submit
    </button>
    <div style="height:18px;"></div>
    <div id="signinErrorMessage" style="margin-left:24px;display:none;color:red;font-weight:bolder;font-size:larger">Invalid User ID or Password</div>
    

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    
    function clearSigninErrorMessage()
    {
        document.getElementById('signinErrorMessage').style.display = 'none';
    }
   
      function validateSignIn() {

        document.getElementById('signinErrorMessage').style.display = "none";

        var userId = document.getElementById('userId').value;
        var password = document.getElementById('password').value;

        var loginXMLRequest = new XMLHttpRequest();

        loginXMLRequest.open("POST", "/Admin/SignIn", false);

        loginXMLRequest.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");

        loginXMLRequest.send("userId=" + userId + "&password=" + password);

        var response = loginXMLRequest.responseText;

        if (response != "SUCCESS") {
            console.log("failure.");
            document.getElementById('signinErrorMessage').style.display = "block";
        }

        else {
            loadMainPage();
        }
    }

    function loadMainPage()
    {
       

        document.getElementById('startupMainPage').style.display = 'none';
        document.getElementById('mainPage').style.display = 'block';
   
    }

    const togglePassword = document
        .querySelector('#togglePassword');
    const password = document.querySelector('#password');
    togglePassword.addEventListener('click', function (e) {
        // toggle the type attribute
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        // toggle the eye slash icon
        this.classList.toggle('fa-eye-slash');
    });
 </script>